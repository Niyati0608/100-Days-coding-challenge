Q25: Write a program to implement a basic calculator using switch-case for +, -, *, /, %.

/*
Sample Test Cases:
Input 1:
4 2 +
Output 1:
6

Input 2:
10 3 %
Output 2:
1

Input 3:
15 5 /
Output 3:
3

*/
#include<stdio.h>
int main(){
    char op;
    float a,b,result;
    printf("enter operator(+,-,*,/,%%):");
    scanf(" %c",&op);
    printf("enter two numbers");
    scanf("%f%f",&a,&b);
    switch(op){
        case'+':
        result=a+b;
        printf("result=%.2f",result);
        break;
        case'-':
        result=a-b;
        printf("Result=%.2f",result);
        break;
        case'*':
        result=a*b;
        printf("result=%.2f",result);
        break;
        case'/':
        if(b!=0)
        printf("result =%.2f",a/b);
        else
        printf("error:division by zero!");
        break;
        case'%':
        printf("reminder=%d",(int)a%(int)b);
        break;
        default:
        printf("invalid operator");
    }
    return 0;
}
